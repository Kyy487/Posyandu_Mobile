APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Produksi: APP_ENV=production dan APP_DEBUG=false.
APP_DEBUG=true
APP_URL=http://localhost:8000

# Origin browser yang diizinkan, pisahkan dengan koma.
# Kosong = tidak ada origin browser yang diizinkan; aplikasi mobile tidak terpengaruh.
# Jangan gunakan `*` untuk API yang memakai token.
CORS_ALLOWED_ORIGINS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Produksi: gunakan LOG_CHANNEL=daily dan batasi file log aplikasi.
LOG_DAILY_DAYS=30

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Kode pendaftaran akun KADER.
# Kosongkan (= tidak diisi) untuk MENONAKKAN pendaftaran kader sepenuhnya.
# Akun kader idealnya dibuat oleh petugas posyandu, bukan mendaftar sendiri.
# JANGAN pernah menaruh kode ini di dalam repository publik.
KADER_REGISTRATION_CODE=

# Akun admin internal (dibuat eksplisit lewat AdminUserSeeder).
POSYANDU_ADMIN_NIK=
POSYANDU_ADMIN_PASSWORD=
POSYANDU_ADMIN_NAME="Admin Posyandu"


# Batas percobaan login: "jumlah_permenit, jumlah_menit"
LOGIN_THROTTLE=10,1
REGISTER_THROTTLE=30,1

# Masa berlaku token Sanctum dalam menit. Default 30 hari.
SANCTUM_TOKEN_EXPIRATION=43200

# Retensi audit log dalam hari. Default 5 tahun.
# Penghapusan hanya manual lewat `php artisan audit:prune`, tidak dijadwalkan.
AUDIT_LOG_RETENTION_DAYS=1825

# Nama posyandu yang melayani. Dipakai sebagai nilai default `location`
# pada agenda kegiatan dan ditampilkan di layar jadwal.
POSYANDU_NAME="Posyandu Desa Sukamaju"

# Berapa bulan setelah usia target sebelum suatu imunisasi yang belum
# dicatat berubah status dari "belum" menjadi "terlambat".
IMMUNIZATION_LATE_AFTER_MONTHS=2


# Integrasi SATUSEHAT FHIR R4
SATUSEHAT_ENV=sandbox
SATUSEHAT_BASE_URL=https://api-satusehat-stg.dto.kemkes.go.id/fhir-r4/v1
SATUSEHAT_AUTH_URL=
SATUSEHAT_CLIENT_ID=dummy
SATUSEHAT_CLIENT_SECRET=dummy
SATUSEHAT_ORG_ID=

