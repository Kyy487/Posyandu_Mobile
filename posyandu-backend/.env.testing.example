# Salin file ini jadi `.env.testing`, lalu isi kredensialnya.
#
# Database test WAJIB dibuat lebih dulu:
#   CREATE DATABASE posyandu_test;
#
# PENTING: database di sini harus berbeda dari database pengembangan.
# `RefreshDatabase` menghapus dan membuat ulang seluruh tabel, jadi salah
# konfigurasi berarti data Posyandu ikut terhapus. Nama database dicek ulang
# oleh `Tests\TestCase` sebelum test jalan.

APP_NAME="Posyandu (Test)"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Aplikasi ini memakai fitur khusus PostgreSQL yang tidak ada di SQLite, jadi
# test TIDAK boleh jalan di SQLite:
#   - partial unique index (medical_notes, measurements, immunization_records)
#   - trigger plpgsql `trg_measurements_who_zscore` yang menghitung z-score WFA
#   - CHECK constraint
# Kalau dipaksa SQLite, test hijau padahal tidak menguji apa yang produksi pakai.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=posyandu_test
DB_USERNAME=postgres
DB_PASSWORD=

BCRYPT_ROUNDS=4
CACHE_STORE=array
MAIL_MAILER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
